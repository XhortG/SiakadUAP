<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SiakadUAP">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SiakadUAP.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.MainActivity" />
        <activity android:name=".activities.LoginActivity" />
        <activity android:name=".activities.BeritaActivity" />
        <activity android:name=".activities.DetailBeritaActivity" />
        <activity android:name=".activities.KrsActivity" />
        <activity android:name=".activities.KhsActivity" />
        <activity android:name=".activities.AbsenActivity" />
        <activity android:name=".activities.JadwalActivity" />
        <activity android:name=".activities.PembayaranActivity" />
        <activity android:name=".activities.PengumumanDetailActivity" />
        <activity android:name=".activities.TranskripActivity" />
        <activity android:name=".activities.IsiKrsActivity" />

    </application>

</manifest>